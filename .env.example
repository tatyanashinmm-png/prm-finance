# Скопируйте в .env (файл .env в .gitignore, никогда не коммитится) и заполните.
# Нужно только для scripts/import-sheet.mjs — локального импорта из Google Sheets.

# JSON сервисного аккаунта reconcile-bot ОДНОЙ строкой. Тот же, что используется
# в проекте invoice-reconcile (GitHub Secret GOOGLE_SA_JSON).
GOOGLE_SA_JSON={"type":"service_account","project_id":"...", ...}

# Либо вместо строки выше — путь к файлу с тем же JSON:
# GOOGLE_SA_JSON_FILE=/Users/you/secrets/reconcile-bot.json

# id гугл-таблицы "Статусы платежей и актов" (из её URL)
SHEET_ID=

# Имя листа, по умолчанию "Платные"
SHEET_TAB=Платные
